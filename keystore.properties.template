# ============================================================
# Release signing configuration template
# ============================================================
# Copy this file to "keystore.properties" (which is gitignored) and fill in
# your real values. Then `./gradlew assembleRelease` will produce a signed APK.
#
# To create a keystore:
#   keytool -genkey -v -keystore meshi-release.jks \
#     -keyalg RSA -keysize 2048 -validity 10000 -alias meshi
#
# IMPORTANT: keep the .jks file and these credentials safe and backed up.
# Every app update MUST be signed with the same key, or users will be unable
# to install the update over an existing install.

# storeFile is resolved relative to the project root.
storeFile=meshi-release.jks
storePassword=CHANGE_ME
keyAlias=meshi
keyPassword=CHANGE_ME
