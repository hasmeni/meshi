<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="splash_bg">#0D1117</color>

    <!-- Main app theme -->
    <style name="Theme.Meshi" parent="android:Theme.Material.Light.NoActionBar" />

    <!-- Splash screen theme (SplashScreen API) -->
    <style name="Theme.Meshi.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_image</item>
        <item name="windowSplashScreenIconBackgroundColor">@color/splash_bg</item>
        <item name="postSplashScreenTheme">@style/Theme.Meshi</item>
    </style>
</resources>
